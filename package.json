{
  "name": "NGO-Backend-TS",
  "version": "1.0.0",
  "description": "Production-ready Express + MongoDB node.js backend boilerplate with TypeScript, JWT authentication, role-based access control, and more.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "postinstall": "npm run build",
    "lint": "eslint src --ext .ts",
    "seed": "ts-node src/seeds/seed.ts --fresh"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/streamifier": "^0.1.2",
    "@types/validator": "^13.15.10",
    "axios": "^1.13.6",
    "bcryptjs": "^2.4.3",
    "chalk": "^5.6.2",
    "cloudinary": "^2.9.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.10.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "rate-limit-redis": "^4.3.1",
    "streamifier": "^0.1.1",
    "stripe": "^20.4.1",
    "typescript": "^5.5.4",
    "validator": "^13.12.0",
    "winston": "^3.19.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4"
  }
